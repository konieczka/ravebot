# Cloudflare AI Gateway (OpenAI-compatible /compat endpoint).
# Without CF_ACCOUNT_ID TechnoBot runs in offline mode and remixes its built-in tracks.
CF_ACCOUNT_ID=
CF_AI_GATEWAY_ID=default
# Only for authenticated gateways (sent as cf-aig-authorization)
CF_AIG_TOKEN=
# Provider key. For workers-ai/* models: a Cloudflare API token with Workers AI permission.
LLM_API_KEY=
LLM_MODEL=workers-ai/@cf/qwen/qwen2.5-coder-32b-instruct
